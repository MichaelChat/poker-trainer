# Copy this file to .env.local (which is gitignored) and fill in your Firebase project's
# config values — Firebase console → Project settings → General → Your apps → SDK setup and
# configuration → Config.
#
# The app runs fine without these set: it just falls back to guest-only mode (no sign-in
# button, stats saved to this browser only via localStorage).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
